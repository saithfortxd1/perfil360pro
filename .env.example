# ---------------------------------------------------------------------------
# Perfil 360 AI — plantilla de variables de entorno
#
# Usa este archivo como referencia; no incluyas secretos en archivos versionados.
# Frontend local: `.env.local`. Netlify Functions local: `.env` para `netlify dev`.
#
# ADVERTENCIA DE SEGURIDAD
# Toda variable con el prefijo VITE_ se INCRUSTA en el bundle del cliente y es
# pública por definición. Nunca coloques secretos privados, claves de servicio,
# tokens de administrador ni credenciales de backend en variables VITE_*.
#
# Las claves del SDK web de Firebase no son secretas (identifican al proyecto,
# no autorizan por sí solas): la seguridad real vive en las reglas de Firestore.
#
# El despliegue final es en NETLIFY. Los secretos se configuran en Netlify UI >
# Site configuration > Environment variables, no en variables VITE_*.
#
# Project ID de referencia: perfil360-8c837
# ---------------------------------------------------------------------------

# --------------------------- FRONTEND (público) ---------------------------

# Project ID de Firebase del proyecto "perfil36".
VITE_FIREBASE_PROJECT_ID=perfil360-8c837

# Identificador público del proyecto (Firebase Console > Configuración > Apps web).
VITE_FIREBASE_API_KEY=

# Dominio de autenticación, formato: <project-id>.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=perfil360-8c837.firebaseapp.com

# Bucket de Cloud Storage.
VITE_FIREBASE_STORAGE_BUCKET=perfil360-8c837.appspot.com

# Remitente de Firebase Cloud Messaging.
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Identificador de la aplicación web registrada.
VITE_FIREBASE_APP_ID=

# Clave pública de reCAPTCHA v3 para App Check (opcional).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# HeyGen LiveAvatar: habilita el avatar de video en el frontend.
# Mantener en 'false' hasta autorizar y validar una sesión real.
VITE_HEYGEN_ENABLED=false

# Los IDs de Olivia y Mateo están centralizados en
# src/services/ai/interviewers.ts; el frontend siempre envía el ID seleccionado.

# Voz de la entrevistadora con lip-sync (Gemini TTS vía /api/tts).
# Para desarrollo local, activar en .env.local y reiniciar `netlify dev`
# SOLO cuando el servidor tenga GEMINI_API_KEY configurada en `.env`.
# Si está en 'false', Olivia y Mateo no reciben voz TTS sincronizada.
VITE_INTERVIEWER_TTS_ENABLED=false

# Emuladores locales: "true" conecta Auth (9099), Firestore (8080) y Storage (9199).
VITE_USE_FIREBASE_EMULATORS=false

# ---------------------------------------------------------------------------
# BACKEND — Netlify Functions (variables SECRETAS, configurar en Netlify UI)
# ---------------------------------------------------------------------------
# Estas variables NO usan prefijo VITE_. Para `netlify dev`, configúralas en un
# archivo `.env` local ignorado por Git. En producción, Netlify UI >
# Site configuration > Environment variables. No copies valores secretos aquí.
#
# HEYGEN_API_KEY           Clave privada de LiveAvatar (https://app.liveavatar.com/)
# HEYGEN_ALLOWED_AVATARS   UUIDs separados por comas (OBLIGATORIA); conserva los existentes y añade:
#                          James:  69a246bd-1739-418d-b533-9fc578208175
#                          Olivia: dc6a2ade-fcad-48b4-89ce-8ae807b18c32
#                          Mateo:  c6fe7922-ef30-4928-98b2-95e44bdf3f1e
# HEYGEN_SANDBOX           'true' añade is_sandbox:true; no garantiza elegibilidad ni ausencia de cargos
# HEYGEN_MAX_SESSIONS_PER_HOUR  Límite de sesiones por usuario y hora (default 5)
# FIREBASE_SERVICE_ACCOUNT JSON del service account de Firebase (para verificar tokens)
# FIREBASE_PROJECT_ID      perfil360-8c837
# ALLOWED_ORIGINS          Orígenes permitidos por CORS, separados por comas
#                          (en Netlify, incluir el dominio del sitio)
#
# --- Gemini TTS (voz del entrevistador con lip-sync) ---
# GEMINI_API_KEY           Clave de la API de Gemini. SOLO en el servidor.
#                          ADVERTENCIA: NO la pongas en VITE_GEMINI_API_KEY.
# Obtener/administrar en https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_TTS_MODEL         Opcional; por defecto gemini-3.8-flash-lite-tts.
#                          Usa Gemini Developer API Interactions:
#                          https://ai.google.dev/gemini-api/docs/speech-generation
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE_OLIVIA  Voz prebuilt para Olivia (por defecto 'Aoede').
# GEMINI_TTS_VOICE_MATEO   Voz prebuilt para Mateo (por defecto 'Puck').
# GEMINI_TTS_VOICE_JAMES   Voz prebuilt para James (por defecto 'Kore').
# Son nombres de voz compatibles con Gemini TTS, no una garantía de género
# acústico; escucha y confirma las muestras en una prueba autorizada.
# GEMINI_TTS_VOICE_OLIVIA=Aoede
# GEMINI_TTS_VOICE_MATEO=Puck
# GEMINI_TTS_VOICE_JAMES=Kore
# GEMINI_API_BASE_URL      Opcional. Por defecto https://generativelanguage.googleapis.com
#
# --- Gemini texto (entrevistas, escenarios, Modo Caos y evaluación) ---
# GEMINI_TEXT_MODEL            Opcional; por defecto gemini-3.5-flash.
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_TEXT_FALLBACK_MODEL   Opcional; por defecto gemini-3.5-flash-lite.
# GEMINI_TEXT_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_MAX_REQUESTS_PER_HOUR Límite compartido por usuario (texto + voz, default 60).
# GEMINI_MAX_REQUESTS_PER_HOUR=60
#
# La misma GEMINI_API_KEY de servidor sirve TTS y texto. Nunca crear
# VITE_GEMINI_API_KEY: las llamadas pasan por /api/gemini y /api/tts.
#
# Configuración manual local:
#   1) Copia la configuración pública Firebase de arriba a `.env.local`.
#   2) Crea `.env` (ignorado por Git) y configura GEMINI_API_KEY y
#      FIREBASE_SERVICE_ACCOUNT para las funciones locales.
#   3) Ejecuta `netlify dev`; Vite aislado no enruta las funciones API.
#
# Configuración manual Netlify:
#   Site configuration > Environment variables: añade GEMINI_API_KEY,
#   FIREBASE_SERVICE_ACCOUNT y las variables opcionales necesarias. No
#   despliegues hasta confirmar la configuración y habilitarlo explícitamente.
